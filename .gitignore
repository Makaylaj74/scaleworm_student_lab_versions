# Python
__pycache__/
*.pyc
*.egg-info/
.venv/

# Jupyter
.ipynb_checkpoints/

# Data (too large for git)
*.zip
*.pth
*.pt
*.parquet
*.mp4
*.png
*.jpg

# Student outputs
scaleworm_students/
scaleworm_starter/

# OS
.DS_Store

# Literature — never commit external publisher PDFs (see literature/README.md)
# This ONLY blocks files under literature/. Generated artifacts under
# outputs/ are deliberately allowed: they are reproducible from version-
# controlled scripts and are not subject to publisher licensing.
literature/**/*.pdf
literature/**/*.epub
literature/**/*.djvu

# IRR round-2 packets (regenerable from scripts/build_irr_packet.py; contain
# gitignored frames/*.png + the .zip — the generated manifests/notebook are outputs)
validation/irr_round_2/packets/

# Derived single-frame counting results (regenerable from 24_count_timeseries.ipynb)
notebooks/timeseries_results_singleframe/
notebooks/model_comparison_frames/
notebooks/model_comparison_results.csv

# YOLO dataset label caches (regenerated each run)
*.cache

# runtime-resolved dataset config (train_v2.py)
data_resolved.yaml

# Large external catalog — regenerable via the URL/md5 in its PROVENANCE.md
external_data/**/*.dat

# Generated interactive figures (regenerable from the plot_*.py scripts)
notebooks/figure_*.html

# Lyr 2017-2020 scene-sort delivery (448 MB; regenerable, never commit)
notebooks/scene_sorting_lg.tar
